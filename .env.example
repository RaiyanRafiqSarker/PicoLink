# ==========================================
# Application Configuration Environment Variables
# ==========================================

PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urlshortener
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
URL_CACHE_TTL=86400

# Rate Limiting (per client IP per minute)
RATE_LIMIT_SHORTEN=30

# Daily links allowed for guests (not logged in)
GUEST_DAILY_LIMIT=3

# Background Click Worker Configuration
WORKER_BATCH_SIZE=50
WORKER_MAX_BATCH_SIZE=100
WORKER_FLUSH_INTERVAL_MS=2000
RUN_WORKER_IN_APP=true
